# Copy to apps/web/.env.local for local development. Never commit .env.local.
# `pnpm db:migrate` and the integration tests read the same file.

# Postgres connection used by the web app's server code and by `pnpm db:migrate`.
#   Local:    postgres://localhost:5432/diwali_house
#   Supabase: use the *transaction* pooler URL (port 6543) for the app, and set
#             DATABASE_POOLED=true. Run migrations with the direct/session URL.
DATABASE_URL=postgres://localhost:5432/diwali_house
DATABASE_POOLED=false

# Integration tests drop and recreate this database. Its name must contain "test".
DATABASE_URL_TEST=postgres://localhost:5432/diwali_house_test

# At least 32 random characters. Used to pepper hashed client IPs for rate
# limiting. Generate with: openssl rand -base64 48
APP_SECRET=replace-me-with-at-least-32-random-characters

# Public origin used in invitation links and QR codes.
PUBLIC_APP_URL=http://localhost:3000

# Only when NOT on Vercel: the header your own edge sets to the client's IP
# (e.g. cf-connecting-ip, x-real-ip). Rate limits trust this header and no other.
# On Vercel, x-vercel-forwarded-for is used automatically.
# CLIENT_IP_HEADER=

# Realtime (Cloudflare Worker in apps/realtime). Generate a local key pair with:
#   pnpm --filter @diwali/realtime-protocol keys
# which writes REALTIME_PRIVATE_KEY here and the public half to apps/realtime/.dev.vars.
# Without these, the party works but the Card Room is unavailable.
REALTIME_PRIVATE_KEY=
REALTIME_URL=ws://localhost:8787
